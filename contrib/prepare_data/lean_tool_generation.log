    "function_body": "lemma StrictMono.not_bddAbove_range [NoMaxOrder α] [SuccOrder β] [IsSuccArchimedean β]
    (hf : StrictMono f) : ¬ BddAbove (Set.range f) := by
  rintro ⟨m, hm⟩
  have hm' : ∀ a, f a ≤ m := λ a ↦ hm $ Set.mem_range_self _
  obtain ⟨a₀⟩ := ‹Nonempty α›
